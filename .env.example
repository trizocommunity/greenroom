# Copy to .env and fill in values. Do not commit .env.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# App runtime: use Supabase connection pooler (port 6543) in production.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrate, deploy, seed): use Supabase direct connection (port 5432).
# Get both URLs from Supabase Dashboard → Project Settings → Database.
# If you only have one URL, set both to the DIRECT connection (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Auth (required)
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# Optional (e.g. Resend for password reset emails, Cloudinary for uploads)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Realtime + Operations
# -----------------------------------------------------------------------------
REALTIME_ENABLED=true
REALTIME_DUAL_PUBLISH=false
REALTIME_STRICT_AUTH=true
REALTIME_OUTBOX_DISPATCH_BATCH_SIZE=100
REALTIME_OUTBOX_MAX_RETRIES=8
REALTIME_OUTBOX_DISPATCHER_ENABLED=false
REALTIME_OUTBOX_PROCESSING_LEASE_MS=120000
REALTIME_OUTBOX_STUCK_RECOVERY_ENABLED=true
REALTIME_REQUIRE_CRON_SECRET_IN_PRODUCTION=true
REALTIME_SOCKET_ENABLED=false
REALTIME_OBSERVABILITY=true
REDIS_URL=
CRON_SECRET=

NEXT_PUBLIC_REALTIME_USE_SOCKET=false
NEXT_PUBLIC_REALTIME_PUBLIC_STANDINGS=false
NEXT_PUBLIC_REALTIME_RECONNECT_BASE_MS=1000
NEXT_PUBLIC_REALTIME_RECONNECT_MAX_MS=15000
