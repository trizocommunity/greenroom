# Copy to .env and fill in values. Do not commit .env.

# -----------------------------------------------------------------------------
# Redis (Redis Cloud) — see issues/ISSUE-44-redis-foundation.md
# -----------------------------------------------------------------------------
# Local dev:   `npm run db:redis:start` brings up redis:7-alpine with the
#              password `devpass` on localhost:6379.
# Prod:        Redis Cloud Essentials, Mumbai (ap-south-1). TLS is on by
#              default — note the `rediss://` scheme (double-s = TLS).
# The `rediss://` (TLS) and `redis://` (plaintext) forms are auto-detected by
# `src/core/redis/client.ts`; no other config needed.
REDIS_URL=redis://:devpass@localhost:6379

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Production / staging (Neon Postgres): two connection strings are required.
#   - DATABASE_URL           — pooled endpoint used by the app at runtime
#                             (e.g. `-pooler.c-XX.aws.neon.tech`). PgBouncer
#                             multiplexes connections across serverless
#                             function invocations.
#   - DATABASE_URL_UNPOOLED  — direct endpoint used by drizzle-kit
#                             (e.g. `c-XX.aws.neon.tech`). Required because
#                             Neon's pooled endpoint doesn't support the
#                             session-level DDL commands drizzle-kit issues.
# Provision via the Neon CLI: `neonctl projects create --name greenroom`,
# then `neonctl connection-string <branch> --pooled` (and without
# `--pooled` for the unpooled variant). See issues/neon-database-adoption.md.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-XX.aws.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.c-XX.aws.neon.tech/DB?sslmode=require"

# -----------------------------------------------------------------------------
# Auth (Better Auth) — see issues/ISSUE-41-auth-foundation-better-auth-migration.md
# -----------------------------------------------------------------------------
# Better Auth (MIT, open-source, self-hosted). Owns the user/admin
# session table, magic-link flow, and Google OAuth. Sessions live in the
# same Postgres the app uses — no SaaS, no per-MAU cost.
#
# Generate a fresh secret:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=<generate-a-secret-at-least-32-characters-long>
# Local dev: http://localhost:3000. Prod (set in Vercel): https://greenroomfestivals.in
BETTER_AUTH_URL=http://localhost:3000
# Local dev: http://localhost:3000. Prod (set in Vercel): https://greenroomfestivals.in,http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Google OAuth (Better Auth social provider). Created at:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI (must match BETTER_AUTH_URL):
#   http://localhost:3000/api/auth/callback/google
#   https://greenroomfestivals.in/api/auth/callback/google
# Authorized JavaScript origins: leave empty (server-side flow, no CORS).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# App URL (required) — must match the origin users open in the browser.
# Local:  http://localhost:3000
# Prod:   https://greenroomfestivals.in  (set in Vercel env vars)
# Wrong value = invitation Accept button points at the wrong host (invalid link).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Payments (Razorpay) — required for payment flows
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend) — required in production, NOT in local development
# -----------------------------------------------------------------------------
# Production: set RESEND_API_KEY in the Vercel dashboard env vars.
# Local dev: leave it unset here. send.ts detects the missing key and
# prints the rendered email to the console via the dev fallback — no
# Resend quota is burned locally.
#
# The `from` address domain MUST be verified in the Resend dashboard
# (https://resend.com/domains) before production emails will deliver.
RESEND_API_KEY=
EMAIL_FROM="Greenroom <info@greenroomfestivals.in>"

# -----------------------------------------------------------------------------
# Cloudinary (image uploads) — optional; uploads fail without it
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_FESTIVAL_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Inngest (durable functions + queue) — see issues/ISSUE-46-redis-advanced-use-cases.md
# -----------------------------------------------------------------------------
# Inngest replaces BullMQ for durable jobs (exports, emails, webhooks,
# imports, render, cron). Required in production; optional in local dev
# (`npx inngest-cli@latest dev` accepts events without a real key).
# Generate the keys at https://www.inngest.com → Environment settings.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# CRON_SECRET is required in production. Vercel Cron sends it as the
# `Authorization: Bearer <CRON_SECRET>` header to /api/v1/cron.
# Generate a fresh secret per env:
#   openssl rand -hex 32
CRON_SECRET=<generate-a-secure-random-token>

# -----------------------------------------------------------------------------
# Vercel API (Phase 2 custom domain TLS provisioning)
# -----------------------------------------------------------------------------
# Required for automated wildcard domain attach + HTTPS provisioning.
# Token: https://vercel.com/account/tokens (scoped to the team)
# Project ID: Vercel dashboard → Project → Settings → General
# Team ID: Vercel dashboard → Team → Settings → General
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=