# Copy to .env and fill in values. Do not commit .env.

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Local dev (docker-compose.yml): postgresql://postgres:postgres@localhost:5433/greenroom
#
# Staging/production (Neon): DATABASE_URL is the pooled connection string used
# by the app at runtime (`neonctl connection-string <branch> --pooled`).
# DATABASE_URL_UNPOOLED is the direct connection string (same command without
# --pooled), used only for running migrations (drizzle-kit generate/push) —
# Neon's pooled endpoint doesn't support the session-level DDL commands
# drizzle-kit issues.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/greenroom"
# DATABASE_URL_UNPOOLED="postgresql://[user]:[password]@[branch-host].neon.tech/[dbname]?sslmode=require"

# -----------------------------------------------------------------------------
# Auth (required)
# -----------------------------------------------------------------------------
JWT_SECRET=your-secret-at-least-32-characters-long

# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -----------------------------------------------------------------------------
# Optional (e.g. Resend for password reset emails, Cloudinary for uploads)
# -----------------------------------------------------------------------------
# RESEND_API_KEY=
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Realtime + Operations
# -----------------------------------------------------------------------------
REALTIME_ENABLED=true
REALTIME_DUAL_PUBLISH=false
REALTIME_STRICT_AUTH=true
REALTIME_OUTBOX_DISPATCH_BATCH_SIZE=100
REALTIME_OUTBOX_MAX_RETRIES=8
REALTIME_OUTBOX_DISPATCHER_ENABLED=false
REALTIME_OUTBOX_PROCESSING_LEASE_MS=120000
REALTIME_OUTBOX_STUCK_RECOVERY_ENABLED=true
REALTIME_REQUIRE_CRON_SECRET_IN_PRODUCTION=true
REALTIME_SOCKET_ENABLED=false
REALTIME_OBSERVABILITY=true
REDIS_URL=
CRON_SECRET=<generate-a-secure-random-token-used-for-cron-job-auth>

NEXT_PUBLIC_REALTIME_USE_SOCKET=false
NEXT_PUBLIC_REALTIME_PUBLIC_STANDINGS=false
NEXT_PUBLIC_REALTIME_RECONNECT_BASE_MS=1000
NEXT_PUBLIC_REALTIME_RECONNECT_MAX_MS=15000
