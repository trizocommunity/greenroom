// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  globalRole    GlobalRole @default(USER)
  fullName      String?
  displayName   String?
  age           Int?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  festivals     Festival[] @relation("CreatedFestivals")
  memberships   FestivalMember[]
  payments      Payment[]

  @@map("user")
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum FestivalStatus {
  UPCOMING
  ONGOING
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  amount          Int           // Amount in paise (100000 = ₹1000)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  razorpayOrderId String?       @unique // Razorpay order ID
  razorpayId      String?       // Razorpay payment ID after success
  validFrom       DateTime      @default(now())
  validUntil      DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  festival        Festival?
  user            User          @relation(fields: [userId], references: [id])

  @@map("payment")
}

model Festival {
  id            String          @id @default(cuid())
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime
  location      String
  status        FestivalStatus  @default(UPCOMING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Payment & Lifecycle
  paymentId     String?         @unique
  payment       Payment?        @relation(fields: [paymentId], references: [id])
  expiresAt     DateTime?
  
  // Public site fields
  slug          String?         @unique
  tagline       String?
  accentColor   String          @default("#0F4C45")
  logo          String?
  heroImage     String?
  
  // Organization info
  orgName           String
  orgDescription    String?
  orgWebsite        String?
  orgLocation       String?
  orgEstablishedYear Int?
  
  // Relations
  creatorId     String
  creator       User            @relation("CreatedFestivals", fields: [creatorId], references: [id], onDelete: Cascade)
  
  members       FestivalMember[]
  
  // Public content relations
  programs      Program[]
  teams         Team[]
  newsItems     NewsItem[]
  galleryImages GalleryImage[]
  
  @@index([creatorId])
  @@map("festival")
}

model Program {
  id          String   @id @default(cuid())
  name        String
  category    String   // "JUNIOR" | "SUBJUNIOR" | "SENIOR"
  posterUrl   String?
  createdAt   DateTime @default(now())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  @@index([festivalId])
  @@map("program")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  score       Int      @default(0)
  rank        Int?
  createdAt   DateTime @default(now())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  @@index([festivalId])
  @@map("team")
}

model NewsItem {
  id          String   @id @default(cuid())
  title       String
  excerpt     String?
  content     String
  publishedAt DateTime @default(now())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  @@index([festivalId])
  @@map("news_item")
}

model GalleryImage {
  id          String   @id @default(cuid())
  url         String
  caption     String?
  createdAt   DateTime @default(now())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  @@index([festivalId])
  @@map("gallery_image")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_token")
}

model FestivalMember {
  id         String   @id @default(cuid())
  userId     String
  festivalId String
  role       String   // "JUDGE" | "PARTICIPANT" | "ADMIN" | "TEAM-LEADER" | "STAGE-MANAGER"
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, festivalId])
  @@index([userId])
  @@index([festivalId])
  @@map("festival_member")
}
