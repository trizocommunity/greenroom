// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum Tier {
  BASIC
  STANDARD
  PRO
}

enum InstitutionType {
  UNIVERSITY
  INSTITUTION
  CAMPUS
  COLLEGE
  MADRASA
  SCHOOL
  OTHER
}

enum FestivalStatus {
  READY   // before startDate
  ONGOING // startDate <= now <= endDate
  PAST    // endDate < now < expiresAt (ended, not yet expired)
  EXPIRED // expiresAt passed and expiration process ran
}

enum ScoringSystem {
  POSITION_BASED
  SCORE_BASED
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String 
  globalRole GlobalRole @default(USER)

  // Profile Fields
  fullName    String?
  displayName String?
  age         Int?
  isActive    Boolean @default(true)

  festival Festival? // ONE festival max
  payments Payment[]
  tokens   PasswordResetToken[]
  memberOf FestivalMember[]
  
  supportTickets SupportTicket[]
  supportNotifications SupportNotification[]

  loginEvents   UserLoginEvent[]
  purchaseSummary UserPurchaseSummary?
  categoryPreferences FestivalCategoryPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expires   DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@map("password_reset_token")
}

enum PaymentPurpose {
  FESTIVAL_CREATION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id          String  @id @default(uuid())
  amount      Int
  currency    String
  status      PaymentStatus @default(PENDING)
  providerId  String // Razorpay Order ID
  referenceId String? // Razorpay Payment ID
  receipt     String?

  tier        Tier?  // Stored for immutable record

  purpose     PaymentPurpose @default(FESTIVAL_CREATION)
  used        Boolean        @default(false)      // True if this payment has been "redeemed"

  validUntil DateTime? 

  userId String
  user   User   @relation(fields: [userId], references: [id])

  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment")
  @@unique([providerId])
  @@index([userId, purpose, status])
  @@index([userId, createdAt])
  @@index([festivalId])
}

model Festival {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  name      String
  slug      String  @unique
  description String?
  
  // Organization Details
  category  String?
  orgName String?
  orgDescription String?
  orgWebsite String?
  orgLocation String?
  establishedYear Int?

  // Core Fields
  institutionType InstitutionType?
  institutionName String?
  location        String?
  startDate       DateTime?
  endDate         DateTime?
  expiresAt       DateTime?

  // Founder/Message
  founderName String?
  founderMessage String?

  branding  Json?
  rules     Json?
  structure Json?

  status   FestivalStatus @default(READY)
  isLocked Boolean        @default(true)

  // Public website visibility (Festival Live)
  publicSiteEnabled Boolean @default(false)

  // Tier & Usage
  tier        Tier @default(STANDARD)
  tierLabel   String @default("Standard")
  
  // Usage Counters
  studentsCount     Int @default(0)
  programmesCount   Int @default(0) // Student competition programmes count
  stagesCount       Int @default(0)
  judgesCount       Int @default(0)
  storageUsedMB     Int @default(0)

  // Deadlines
  studentCreationDeadline     DateTime?
  programmeAssignmentDeadline DateTime?

  // Settings
  chestNumberSettings Json? // { prefix: string, nextSequence: number }
  scoringSystem ScoringSystem @default(SCORE_BASED)
  maxResultScore Int? // For SCORE_BASED: max score judge can give (e.g. 80). Grade = (score/maxResultScore)*100. Default 10.
  
  // Decoupled Leaderboard Snapshot
  teamStandings Json? // Stores the "Published" state of the leaderboard

  // Post-expiration retention (set by expiration cron)
  resultPdfUrl  String?   // URL to final results PDF
  expiredAt     DateTime? // When expiration process ran

  // Child Entities
  payments      Payment[]
  students      Student[]
  categories    Category[]
  groups        Group[]
  programmes    Programme[]
  programmeAssignments ProgrammeAssignment[]
  stages        Stage[]
  scheduleEntries ScheduleEntry[]
  supportTickets SupportTicket[]
  results       Result[]
  galleryImages FestivalGalleryImage[]
  newsPosts     FestivalNews[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       FestivalMember[]
  expiredResults ExpiredFestivalResult[]
  lifecycleEvents FestivalLifecycleEvent[]

  @@map("festival")
  @@index([status])
  @@index([expiresAt])
}

model ExpiredFestivalResult {
  id             String   @id @default(uuid())
  festivalId     String
  festival       Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  programmeName  String
  categoryName   String?
  participantName String  // Student or team display name at snapshot time
  position       Int?
  grade          String?
  score          Float?
  points         Int?
  createdAt      DateTime @default(now())

  @@map("expired_festival_result")
  @@index([festivalId])
}

enum FestivalLifecycleEventType {
  CREATED
  ACTIVATED
  EXPIRED
}

model FestivalLifecycleEvent {
  id         String                 @id @default(uuid())
  festivalId String
  festival   Festival               @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  event      FestivalLifecycleEventType
  occurredAt DateTime               @default(now())
  metadata   Json?

  @@map("festival_lifecycle_event")
  @@index([festivalId])
}

model FestivalGalleryImage {
  id         String   @id @default(uuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("festival_gallery_image")
}

model FestivalNews {
  id          String    @id @default(uuid())
  festivalId  String
  festival    Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  title       String
  excerpt     String?   // Short summary for meta / social sharing
  content     String    // Description / body
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("festival_news")
}

enum FestivalRole {
  ADMIN
  ANNOUNCER
  STAGE_MANAGER
}

model FestivalMember {
  id        String   @id @default(uuid())
  
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      FestivalRole @default(ANNOUNCER)
  
  isActive  Boolean @default(true)
  metadata  Json?   // Store initial password here if absolutely needed for "Show Password" feature

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([festivalId, userId])
  @@map("festival_member")
}

model Category {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  name        String
  type        CategoryType @default(SINGLE)
  description String?
  
  programmes  Programme[]
  students    Student[]

  assignments ProgrammeAssignment[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("category")
}

enum CategoryType {
  SINGLE
  GENERAL
}

model Programme {
  id          String        @id @default(uuid())
  festivalId  String
  festival    Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  type        ProgrammeType @default(INDIVIDUAL)
  stageType   StageType     @default(STAGE)
  maxParticipantsPerGroup Int @default(1) // For Individual: Max assignments per group
  maxTeamsPerGroup        Int @default(1) // For Group: Max teams per group
  maxStudentsPerTeam      Int @default(1) // For Group: Max students per team

  assignments ProgrammeAssignment[]
  results     Result[]
  scheduleEntries ScheduleEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([festivalId, createdAt(sort: Desc)])
  @@map("programme")
}

model Group {
  id          String    @id @default(uuid())
  festivalId  String
  festival    Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  name        String
  color       String    @default("#2563eb")
  seriesStart Int       @default(100)

  students    Student[]
  assignments  ProgrammeAssignment[]


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([festivalId, createdAt(sort: Desc)])
  @@map("group")
}

model ProgrammeAssignment {
  id            String    @id @default(uuid())
  festivalId    String
  festival      Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  groupId       String?
  group         Group? @relation(fields: [groupId], references: [id]) 

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id]) 

  teamNumber    Int      @default(1)

  result        Result?

  assignedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  @@unique([programmeId, studentId])
  
  @@map("programme_assignment")
}

model Result {
  id            String              @id @default(uuid())
  festivalId    String
  festival      Festival            @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  programmeId   String
  programme     Programme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  
  assignmentId  String              @unique
  assignment    ProgrammeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  // Scoring & Ranking

  grade         String?             // A+, A, B+, B, C, etc.
  position      Int?                // 1, 2, 3 (rank within programme)
  score         Float               @default(0) // Judge's score (out of 10)
  points        Int                 @default(0) // Points awarded based on position
  
  // Metadata
  remarks       String?             // Judge comments/feedback
  isPublished   Boolean             @default(false) // Control public visibility
  
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  @@index([festivalId, createdAt(sort: Desc)])
  @@map("result")
}

model Student {
  id        String   @id @default(uuid())
  
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name       String
  email      String?
  phone      String?
  gender     Gender   @default(MALE)
  
  // registrationNumber String? // Removed as per request
  chestNumber        String? // Generated Chest Number
  isTeamLeader       Boolean @default(false)
  
  age                Int?
  standard           String? // Class/Standard

  /** URL-safe slug for public profile: /{festivalSlug}/{profileSlug} */
  profileSlug        String?

  assignments ProgrammeAssignment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique([festivalId, phone]) // Keep phone unique if used
  @@index([festivalId])
  @@index([groupId])
  @@index([festivalId, createdAt(sort: Desc)])
  @@unique([festivalId, chestNumber])
  @@unique([festivalId, profileSlug])
  @@map("student")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorRole   String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}

enum ProgrammeType {
  INDIVIDUAL
  GROUP
}

enum StageType {
  STAGE
  NON_STAGE
}

enum GroupType {
  SCHOOL
  COLLEGE
  MADRASA
  OPEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SessionType {
  GENERAL
  CEREMONY
  TALK
  CONCERT
}

model Stage {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  name        String
  description String?
  
  // Who created it (User Name or ID)
  createdBy   String?

  scheduleEntries ScheduleEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stage")
  @@index([festivalId])
}

enum ScheduleEntryType {
  PROGRAMME
  SESSION
}

model ScheduleEntry {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  type        ScheduleEntryType @default(PROGRAMME)

  programmeId String?
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)

  /// For SESSION type: display name
  title       String?
  /// For SESSION type
  description String?
  speakers    String?
  sessionType SessionType?

  startTime   DateTime
  endTime     DateTime?
  order       Int      @default(0)

  createdBy   String?
  updatedBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([festivalId])
  @@index([festivalId, startTime])
  @@index([festivalId, type])
  @@map("schedule_entry")
}

// -----------------------------------------------------------------------------
// Support System Models
// -----------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model SupportTicket {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String
  category  String         @default("General") // e.g., Technical, Billing, Feature Request
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  
  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  messages  SupportMessage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@map("support_ticket")
  @@index([festivalId])
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  senderType String // "USER" or "ADMIN"
  senderId   String // User ID of sender
  
  message    String
  attachmentUrl String?
  
  isRead     Boolean @default(false)
  
  createdAt  DateTime @default(now())
  
  @@index([ticketId])
  @@map("support_message")
}

model SupportNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String   // "NEW_REPLY", "STATUS_CHANGE"
  referenceId String // Ticket ID or Message ID
  
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@map("support_notification")
}

// -----------------------------------------------------------------------------
// System Config (Super Admin: plan feature overrides, etc.)
// -----------------------------------------------------------------------------

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// -----------------------------------------------------------------------------
// Analytics & Behaviour (Phase 5)
// -----------------------------------------------------------------------------

model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  ip        String?      // optional: last known IP
  userAgent String?      // optional: UA snapshot

  @@index([userId, loggedAt])
  @@map("user_login_event")
}

/// Aggregated purchase summary per user for Super Admin analytics.
model UserPurchaseSummary {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSpend      Int      @default(0)        // in smallest currency unit (e.g. paise)
  festivalsCount  Int      @default(0)
  lastPurchaseAt  DateTime?
  // JSON blobs to keep schema simple while still useful for analytics dashboards.
  festivalIds     Json?    // e.g. ["festival-id-1", "festival-id-2", ...]
  planCountsByTier Json?   // e.g. { "BASIC": 3, "STANDARD": 1 }

  updatedAt       DateTime @updatedAt

  @@map("user_purchase_summary")
}

/// Optional: preference score for categories derived from purchases.
model FestivalCategoryPreference {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   String   // e.g. "School", "College", custom category name
  weight     Int      @default(0) // higher = stronger preference
  updatedAt  DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
  @@map("festival_category_preference")
}
