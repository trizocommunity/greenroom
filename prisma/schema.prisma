generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                       @id @default(uuid())
  email                  String                       @unique
  password               String
  globalRole             GlobalRole                   @default(USER)
  fullName               String?
  displayName            String?
  age                    Int?
  isActive               Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  festival               Festival?
  categoryPreferences    FestivalCategoryPreference[]
  memberOf               FestivalMember[]
  tokens                 PasswordResetToken[]
  payments               Payment[]
  programmeNotifications ProgrammeNotification[]
  realtimeOutboxEvents   RealtimeOutbox[]
  loginEvents            UserLoginEvent[]
  purchaseSummary        UserPurchaseSummary[]

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expires   DateTime
  userId    String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_token")
}

model Payment {
  id          String         @id @default(uuid())
  amount      Int
  currency    String
  providerId  String         @unique
  referenceId String?
  receipt     String?
  validUntil  DateTime?
  userId      String
  festivalId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  purpose     PaymentPurpose @default(FESTIVAL_CREATION)
  used        Boolean        @default(false)
  status      PaymentStatus  @default(PENDING)
  tier        Tier?
  festival    Festival?      @relation(fields: [festivalId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@index([userId, purpose, status])
  @@index([userId, createdAt])
  @@index([festivalId])
  @@map("payment")
}

model Festival {
  id                          String                      @id @default(uuid())
  ownerId                     String                      @unique
  name                        String
  slug                        String                      @unique
  category                    String?
  description                 String?
  orgName                     String?
  orgDescription              String?
  orgWebsite                  String?
  orgLocation                 String?
  establishedYear             Int?
  founderName                 String?
  founderMessage              String?
  branding                    Json?
  rules                       Json?
  structure                   Json?
  isLocked                    Boolean                     @default(true)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  maxResultScore              Int?
  expiresAt                   DateTime?
  institutionName             String?
  institutionType             InstitutionType?
  judgesCount                 Int                         @default(0)
  location                    String?
  programmeAssignmentDeadline DateTime?
  storageUsedMB               Int                         @default(0)
  tier                        Tier                        @default(STANDARD)
  tierLabel                   String                      @default("Standard")
  studentCreationDeadline     DateTime?
  studentsCount               Int                         @default(0)
  publicSiteEnabled           Boolean                     @default(false)
  stagesCount                 Int                         @default(0)
  startDate                   DateTime?
  endDate                     DateTime?
  programmesCount             Int                         @default(0)
  chestNumberSettings         Json?
  teamStandings               Json?
  scoringSystem               ScoringSystem               @default(SCORE_BASED)
  status                      FestivalStatus              @default(READY)
  resultPdfUrl                String?
  expiredAt                   DateTime?
  categories                  Category[]
  expiredResults              ExpiredFestivalResult[]
  owner                       User                        @relation(fields: [ownerId], references: [id])
  galleryImages               FestivalGalleryImage[]
  lifecycleEvents             FestivalLifecycleEvent[]
  members                     FestivalMember[]
  newsPosts                   FestivalNews[]
  groups                      Group[]
  payments                    Payment[]
  programmes                  Programme[]
  programmeAssignments        ProgrammeAssignment[]
  programmeCodeLetters        ProgrammeCodeLetter[]
  programme_judge_session     ProgrammeJudgeSession[]
  programmeNotifications      ProgrammeNotification[]
  reportingSessions           ProgrammeReportingSession[]
  realtimeOutboxEvents        RealtimeOutbox[]
  results                     Result[]
  scheduleEntries             ScheduleEntry[]
  stages                      Stage[]
  students                    Student[]
  teamLeaderSessions          TeamLeaderSession[]

  @@index([expiresAt])
  @@map("festival")
}

model ExpiredFestivalResult {
  id              String   @id @default(uuid())
  festivalId      String
  programmeName   String
  categoryName    String?
  participantName String
  position        Int?
  grade           String?
  score           Float?
  points          Int?
  createdAt       DateTime @default(now())
  festival        Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@index([festivalId])
  @@map("expired_festival_result")
}

model FestivalLifecycleEvent {
  id         String                     @id @default(uuid())
  festivalId String
  event      FestivalLifecycleEventType
  occurredAt DateTime                   @default(now())
  metadata   Json?
  festival   Festival                   @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@index([festivalId])
  @@map("festival_lifecycle_event")
}

model FestivalGalleryImage {
  id         String   @id @default(uuid())
  festivalId String
  url        String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@map("festival_gallery_image")
}

model FestivalNews {
  id          String    @id @default(uuid())
  festivalId  String
  title       String
  content     String
  imageUrl    String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  excerpt     String?
  festival    Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@map("festival_news")
}

model FestivalMember {
  id         String       @id @default(uuid())
  festivalId String
  userId     String
  role       FestivalRole @default(ANNOUNCER)
  isActive   Boolean      @default(true)
  metadata   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  festival   Festival     @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([festivalId, userId])
  @@map("festival_member")
}

model Category {
  id          String                @id @default(uuid())
  festivalId  String
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  type        CategoryType          @default(SINGLE)
  festival    Festival              @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  programmes  Programme[]
  assignments ProgrammeAssignment[]
  students    Student[]

  @@map("category")
}

model Programme {
  id                      String                      @id @default(uuid())
  categoryId              String
  name                    String
  type                    ProgrammeType               @default(INDIVIDUAL)
  stageType               StageType                   @default(STAGE)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  festivalId              String
  maxParticipantsPerGroup Int                         @default(1)
  maxTeamsPerGroup        Int                         @default(1)
  maxStudentsPerTeam      Int                         @default(1)
  status                  ProgrammeStatus             @default(READY)
  publishedAt             DateTime?
  category                Category                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  festival                Festival                    @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  assignments             ProgrammeAssignment[]
  codeLetters             ProgrammeCodeLetter[]
  programme_judge_session ProgrammeJudgeSession[]
  reportingSessions       ProgrammeReportingSession[]
  results                 Result[]
  scheduleEntries         ScheduleEntry[]

  @@index([festivalId, createdAt(sort: Desc)])
  @@index([festivalId, status])
  @@map("programme")
}

model Group {
  id                   String                         @id @default(uuid())
  festivalId           String
  name                 String
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  seriesStart          Int                            @default(100)
  color                String                         @default("#2563eb")
  festival             Festival                       @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  assignments          ProgrammeAssignment[]
  reportedParticipants ProgrammeReportedParticipant[]
  students             Student[]

  @@index([festivalId, createdAt(sort: Desc)])
  @@map("group")
}

model ProgrammeAssignment {
  id                   String                         @id @default(uuid())
  programmeId          String
  groupId              String?
  assignedAt           DateTime                       @default(now())
  festivalId           String
  categoryId           String?
  studentId            String?
  teamNumber           Int                            @default(1)
  createdByEmail       String?
  createdByName        String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @default(now()) @updatedAt
  category             Category?                      @relation(fields: [categoryId], references: [id])
  festival             Festival                       @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  group                Group?                         @relation(fields: [groupId], references: [id])
  programme            Programme                      @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  student              Student?                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedParticipants ProgrammeReportedParticipant[]
  result               Result?

  @@unique([programmeId, studentId])
  @@map("programme_assignment")
}

model Result {
  id           String              @id @default(uuid())
  festivalId   String
  programmeId  String
  assignmentId String              @unique
  grade        String?
  position     Int?
  score        Float               @default(0)
  points       Int                 @default(0)
  remarks      String?
  isPublished  Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignment   ProgrammeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  festival     Festival            @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  programme    Programme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([festivalId, createdAt(sort: Desc)])
  @@map("result")
}

model Student {
  id                     String                         @id @default(uuid())
  festivalId             String
  groupId                String
  categoryId             String
  name                   String
  email                  String?
  phone                  String?
  gender                 Gender                         @default(MALE)
  isTeamLeader           Boolean                        @default(false)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  chestNumber            String?
  age                    Int?
  standard               String?
  /// * URL-safe slug for public profile: /{festivalSlug}/{profileSlug}
  profileSlug            String?
  assignments            ProgrammeAssignment[]
  codeLetterRecipients   ProgrammeCodeLetterRecipient[]
  programmeNotifications ProgrammeNotification[]
  reportedParticipants   ProgrammeReportedParticipant[]
  category               Category                       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  festival               Festival                       @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  group                  Group                          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teamLeaderOtps         TeamLeaderOtp[]
  teamLeaderSessions     TeamLeaderSession[]

  @@unique([festivalId, chestNumber])
  @@unique([festivalId, profileSlug])
  @@index([festivalId])
  @@index([groupId])
  @@index([festivalId, createdAt(sort: Desc)])
  @@map("student")
}

model TeamLeaderOtp {
  id         String    @id @default(uuid())
  studentId  String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, expiresAt])
  @@index([expiresAt])
  @@map("team_leader_otp")
}

model TeamLeaderSession {
  id         String    @id @default(uuid())
  studentId  String
  festivalId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  festival   Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, expiresAt])
  @@index([festivalId, expiresAt])
  @@index([expiresAt])
  @@map("team_leader_session")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@map("audit_log")
}

model Stage {
  id                String                      @id @default(uuid())
  festivalId        String
  name              String
  description       String?
  createdBy         String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  reportingSessions ProgrammeReportingSession[]
  scheduleEntries   ScheduleEntry[]
  festival          Festival                    @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@index([festivalId])
  @@map("stage")
}

model ScheduleEntry {
  id                String                     @id @default(uuid())
  festivalId        String
  programmeId       String?
  stageId           String?
  startTime         DateTime
  endTime           DateTime?
  order             Int                        @default(0)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  type              ScheduleEntryType          @default(PROGRAMME)
  /// For SESSION type: display name
  title             String?
  /// For SESSION type
  description       String?
  speakers          String?
  sessionType       SessionType?
  reportingSessions ProgrammeReportingSession?
  festival          Festival                   @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  programme         Programme?                 @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage             Stage?                     @relation(fields: [stageId], references: [id])

  @@index([festivalId])
  @@index([festivalId, startTime])
  @@index([festivalId, type])
  @@map("schedule_entry")
}

model ProgrammeReportingSession {
  id                      String                         @id @default(uuid())
  festivalId              String
  scheduleEntryId         String                         @unique
  programmeId             String
  stageId                 String?
  status                  ProgrammeReportingStatus       @default(NOT_STARTED)
  startedAt               DateTime?
  startedBy               String?
  endedAt                 DateTime?
  endedBy                 String?
  windowEndsAt            DateTime?
  isLocked                Boolean                        @default(false)
  closedAtScheduleStart   Boolean                        @default(true)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  codeLetters             ProgrammeCodeLetter[]
  programme_judge_session ProgrammeJudgeSession[]
  reportedParticipants    ProgrammeReportedParticipant[]
  festival                Festival                       @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  programme               Programme                      @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  scheduleEntry           ScheduleEntry                  @relation(fields: [scheduleEntryId], references: [id], onDelete: Cascade)
  stage                   Stage?                         @relation(fields: [stageId], references: [id])

  @@index([festivalId, status])
  @@index([programmeId])
  @@map("programme_reporting_session")
}

model ProgrammeReportedParticipant {
  id                 String                    @id @default(uuid())
  reportingSessionId String
  assignmentId       String
  studentId          String?
  groupId            String?
  teamNumber         Int?
  reportedAt         DateTime                  @default(now())
  reportedBy         String?
  assignment         ProgrammeAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  group              Group?                    @relation(fields: [groupId], references: [id])
  reportingSession   ProgrammeReportingSession @relation(fields: [reportingSessionId], references: [id], onDelete: Cascade)
  student            Student?                  @relation(fields: [studentId], references: [id])

  @@unique([reportingSessionId, assignmentId], map: "programme_reported_participant_reportingSessionId_assignmentId_")
  @@index([studentId])
  @@index([groupId])
  @@map("programme_reported_participant")
}

model ProgrammeCodeLetter {
  id                 String                         @id @default(uuid())
  festivalId         String
  reportingSessionId String
  programmeId        String
  code               String
  issuedAt           DateTime                       @default(now())
  issuedBy           String?
  festival           Festival                       @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  programme          Programme                      @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  reportingSession   ProgrammeReportingSession      @relation(fields: [reportingSessionId], references: [id], onDelete: Cascade)
  recipients         ProgrammeCodeLetterRecipient[]

  @@unique([reportingSessionId, code])
  @@index([festivalId, issuedAt])
  @@index([programmeId])
  @@map("programme_code_letter")
}

model ProgrammeCodeLetterRecipient {
  id           String              @id @default(uuid())
  codeLetterId String
  studentId    String
  createdAt    DateTime            @default(now())
  codeLetter   ProgrammeCodeLetter @relation(fields: [codeLetterId], references: [id], onDelete: Cascade)
  student      Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([codeLetterId, studentId])
  @@index([studentId])
  @@map("programme_code_letter_recipient")
}

model ProgrammeJudgeSession {
  id                           String                    @id @default(uuid())
  festival_id                  String
  programme_id                 String
  reporting_session_id         String
  token_hash                   String                    @unique
  started_at                   DateTime
  used_at                      DateTime?
  ended_at                     DateTime?
  created_at                   DateTime                  @default(now())
  created_by                   String?
  updated_at                   DateTime
  opened_at                    DateTime?
  open_expires_at              DateTime?
  open_nonce_hash              String?
  open_client_fingerprint_hash String?
  submitted_by_name            String?
  submitted_by_contact         String?
  submitted_by_note            String?
  festival                     Festival                  @relation(fields: [festival_id], references: [id], onDelete: Cascade)
  programme                    Programme                 @relation(fields: [programme_id], references: [id], onDelete: Cascade)
  programme_reporting_session  ProgrammeReportingSession @relation(fields: [reporting_session_id], references: [id], onDelete: Cascade)

  @@index([open_expires_at])
  @@index([programme_id, used_at])
  @@index([reporting_session_id])
  @@index([token_hash, used_at])
  @@map("programme_judge_session")
}

model ProgrammeNotification {
  id                 String                         @id @default(uuid())
  festivalId         String
  eventType          ProgrammeNotificationEventType
  recipientUserId    String?
  recipientStudentId String?
  title              String
  body               String
  payload            Json?
  channels           Json?
  isRead             Boolean                        @default(false)
  createdAt          DateTime                       @default(now())
  festival           Festival                       @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  recipientStudent   Student?                       @relation(fields: [recipientStudentId], references: [id], onDelete: Cascade)
  recipientUser      User?                          @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([festivalId, createdAt])
  @@index([recipientUserId, isRead])
  @@index([recipientStudentId, isRead])
  @@map("programme_notification")
}

model RealtimeOutbox {
  id             String               @id @default(uuid())
  eventId        String               @unique
  eventName      String
  eventVersion   Int                  @default(1)
  festivalId     String
  entityType     String
  entityId       String
  payload        Json
  roomKeys       Json
  correlationId  String?
  idempotencyKey String
  sequence       Int?
  actorUserId    String?
  status         RealtimeOutboxStatus @default(PENDING)
  retryCount     Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  errorMessage   String?
  dispatchedAt   DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  actorUser      User?                @relation(fields: [actorUserId], references: [id])
  festival       Festival             @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  @@unique([eventName, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([festivalId, createdAt])
  @@index([eventName, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("realtime_outbox")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  loggedAt  DateTime @default(now())
  ip        String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("user_login_event")
}

/// Aggregated purchase summary per user for Super Admin analytics.
model UserPurchaseSummary {
  userId           String    @id
  totalSpend       Int       @default(0)
  festivalsCount   Int       @default(0)
  lastPurchaseAt   DateTime?
  festivalIds      Json?
  planCountsByTier Json?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_purchase_summary")
}

/// Optional: preference score for categories derived from purchases.
model FestivalCategoryPreference {
  id        String   @id @default(cuid())
  userId    String
  category  String
  weight    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
  @@map("festival_category_preference")
}

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum Tier {
  BASIC
  STANDARD
  PRO
}

enum InstitutionType {
  COLLEGE
  MADRASA
  SCHOOL
  OTHER
  UNIVERSITY
  INSTITUTION
  CAMPUS
}

enum FestivalStatus {
  READY
  ONGOING
  PAST
  EXPIRED
}

enum ScoringSystem {
  POSITION_BASED
  SCORE_BASED
}

enum PaymentPurpose {
  FESTIVAL_CREATION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FestivalLifecycleEventType {
  CREATED
  ACTIVATED
  EXPIRED
}

enum FestivalRole {
  ADMIN
  ANNOUNCER
  STAGE_MANAGER
}

enum CategoryType {
  SINGLE
  GENERAL
}

enum ProgrammeStatus {
  READY
  ASSIGNED
  SCHEDULED
  REPORTING
  STARTED
  ENDED
  JUDGED
  PUBLISHED
  RESET
}

enum ProgrammeType {
  INDIVIDUAL
  GROUP
}

enum StageType {
  STAGE
  NON_STAGE
}

enum GroupType {
  SCHOOL
  COLLEGE
  MADRASA
  OPEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SessionType {
  GENERAL
  CEREMONY
  TALK
  CONCERT
}

enum ScheduleEntryType {
  PROGRAMME
  SESSION
}

enum ProgrammeReportingStatus {
  NOT_STARTED
  IN_PROGRESS
  RESET
  CLOSED
}

enum ProgrammeNotificationEventType {
  REPORTING_STARTED
  REPORTING_RESET
  REPORTING_PARTICIPANT_MARKED
  REPORTING_CLOSED
  CODE_LETTER_ISSUED
  PROGRAMME_STATUS_CHANGED
}

enum RealtimeOutboxStatus {
  PENDING
  PROCESSING
  DISPATCHED
  FAILED
}
