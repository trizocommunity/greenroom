// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum Tier {
  BASIC
  STANDARD
  PRO
}

enum InstitutionType {
  COLLEGE
  MADRASA
  SCHOOL
  OTHER
}

enum FestivalStatus {
  DRAFT // created but locked
  ACTIVE // unlocked (paid)
  EXPIRED // past 40 days
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String 
  globalRole GlobalRole @default(USER)

  // Profile Fields
  fullName    String?
  displayName String?
  age         Int?
  isActive    Boolean @default(true)

  festival Festival? // ONE festival max
  payments Payment[]
  tokens   PasswordResetToken[]
  memberOf FestivalMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expires   DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_token")
}

enum PaymentPurpose {
  FESTIVAL_CREATION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id          String  @id @default(uuid())
  amount      Int
  currency    String
  status      PaymentStatus @default(PENDING)
  providerId  String // Razorpay Order ID
  referenceId String? // Razorpay Payment ID
  receipt     String?

  tier        Tier?  // Stored for immutable record

  purpose     PaymentPurpose @default(FESTIVAL_CREATION)
  used        Boolean        @default(false)      // True if this payment has been "redeemed"

  validUntil DateTime? 

  userId String
  user   User   @relation(fields: [userId], references: [id])

  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment")
}

model Festival {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  name      String
  slug      String  @unique
  description String?
  
  // Organization Details
  category  String?
  orgName String?
  orgDescription String?
  orgWebsite String?
  orgLocation String?
  establishedYear Int?

  // Core Fields
  institutionType InstitutionType?
  institutionName String?
  location        String?
  expiresAt       DateTime?

  // Founder/Message
  founderName String?
  founderMessage String?

  branding  Json?
  rules     Json?
  structure Json?

  status   FestivalStatus @default(DRAFT)
  isLocked Boolean        @default(true)
  
  // Tier & Usage
  tier        Tier @default(STANDARD)
  tierLabel   String @default("Standard")
  
  // Usage Counters
  participantsCount Int @default(0)
  eventsCount       Int @default(0)
  judgesCount       Int @default(0)
  storageUsedMB     Int @default(0)

  // Deadlines
  participantCreationDeadline DateTime?
  programmeAssignmentDeadline DateTime?

  // Child Entities
  payments      Payment[]
  participants  Participant[]
  categories    Category[]
  groups        Group[]
  programmes    Programme[]
  programmeAssignments ProgrammeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       FestivalMember[]
  
  @@map("festival")
}

enum FestivalRole {
  TEAM_LEADER
  ADMIN
}

model FestivalMember {
  id        String   @id @default(uuid())
  
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])

  role      FestivalRole @default(TEAM_LEADER)
  
  isActive  Boolean @default(true)
  metadata  Json?   // Store initial password here if absolutely needed for "Show Password" feature

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([festivalId, userId])
  @@map("festival_member")
}

model Category {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  
  programmes  Programme[]
  participants Participant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("category")
}

model Programme {
  id          String        @id @default(uuid())
  festivalId  String
  festival    Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  type        ProgrammeType @default(INDIVIDUAL)
  stageType   StageType     @default(STAGE)
  maxEntries  Int           @default(1)

  assignments ProgrammeAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programme")
}

model Group {
  id          String    @id @default(uuid())
  festivalId  String
  festival    Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  name        String
  type        GroupType @default(SCHOOL)

  participants Participant[]
  assignments  ProgrammeAssignment[]
  members      FestivalMember[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("group")
}

model ProgrammeAssignment {
  id            String    @id @default(uuid())
  festivalId    String
  festival      Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  groupId       String?
  group         Group? @relation(fields: [groupId], references: [id]) 

  assignedAt    DateTime @default(now())

  @@unique([programmeId, participantId])
  
  @@map("programme_assignment")
}

model Participant {
  id        String  @id @default(uuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  // Child of a Group? Or direct? In schema it has groupId as relation.
  groupId   String
  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name               String
  email              String? 
  phone              String?
  gender             Gender?
  registrationNumber String?

  assignments ProgrammeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([festivalId, email]) 

  @@map("participant")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorRole   String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}

enum ProgrammeType {
  INDIVIDUAL
  GROUP
}

enum StageType {
  STAGE
  NON_STAGE
}

enum GroupType {
  SCHOOL
  COLLEGE
  MADRASA
  OPEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
