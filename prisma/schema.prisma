// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum FestivalStatus {
  DRAFT // created but locked
  ACTIVE // unlocked (after first paid edition)
}

enum EditionStatus {
  ACTIVE // 0–90 days (write + read)
  FREEZE // read-only
  ARCHIVED // cold storage
}

enum EditionTier {
  BASIC
  STANDARD
  PRO
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String // Note: Was passwordHash in old schema, sticking to requirement "password" but usually this implies hashed
  globalRole GlobalRole @default(USER)

  // Profile Fields (Restored for compability)
  fullName    String?
  displayName String?
  age         Int?
  isActive    Boolean @default(true)

  festival Festival? // ONE festival max
  payments Payment[]
  tokens   PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user") // Optional: keeping map for potential existing conventions or cleaner DB names
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expires   DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_token")
}

enum PaymentPurpose {
  FESTIVAL_AND_FIRST_EDITION
  NEW_EDITION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id          String  @id @default(uuid())
  amount      Int
  currency    String
  status      PaymentStatus @default(PENDING)
  providerId  String // Razorpay Order ID
  referenceId String? // Razorpay Payment ID
  receipt     String?

  tier        EditionTier?  // Stored for immutable record

  purpose     PaymentPurpose @default(NEW_EDITION) // Defaulting to avoid breaking old rows immediately, but practically mostly used for upgrades.
  used        Boolean        @default(false)      // True if this payment has been "redeemed" to create a resource

  validUntil DateTime? // Logic: Subscription valid until... (Made optional as logic shifts to Edition)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id])

  editionId String?
  edition   Edition? @relation(fields: [editionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment")
}

model Festival {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  name      String
  slug      String  @unique
  category  String?
  description String?
  
  // Organization Details
  orgName String?
  orgDescription String?
  orgWebsite String?
  orgLocation String? // To match mocked data usage
  establishedYear Int?

  // Founder/Message
  founderName String?
  founderMessage String?

  branding  Json?
  rules     Json?
  structure Json?

  status   FestivalStatus @default(DRAFT)
  isLocked Boolean        @default(true)

  editions Edition[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("festival")
}

model Edition {
  id         String   @id @default(uuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id])

  number Int // Sequential edition number (1, 2, 3...)
  slug   String // URL-friendly identifier
  tier   EditionTier @default(STANDARD)
  tierLabel String @default("Standard") // Added for UI identity persistence
  status EditionStatus @default(ACTIVE)

  startDate DateTime
  endDate   DateTime

  // Details
  description String?
  theme       String?
  venue       String?
  location    String?

  // Usage Counters (Phase 4)
  participantsCount Int @default(0)
  eventsCount       Int @default(0)
  judgesCount       Int @default(0)
  storageUsedMB     Int @default(0)

  limits EditionLimit?
  
  createdByPaymentId String? // validation: must exist
  payments Payment[]

  participants Participant[]
  categories   EditionCategory[]
  groups       EditionGroup[]
  programmes   Programme[]
  programmeAssignments ProgrammeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([festivalId, slug])
  @@map("edition")
}



model EditionLimit {
  id        String  @id @default(uuid())
  editionId String  @unique
  edition   Edition @relation(fields: [editionId], references: [id])

  maxParticipants Int @default(1000)
  maxEvents       Int @default(100)
  maxJudges       Int @default(50)
  maxStorageMB    Int @default(1024)

  createdAt DateTime @default(now())

  @@map("edition_limit")
}

// -----------------------------------------------------------------------------
// Pre-Works Enums
// -----------------------------------------------------------------------------

enum ProgrammeType {
  INDIVIDUAL
  GROUP
}

enum StageType {
  STAGE
  NON_STAGE
}

enum GroupType {
  SCHOOL
  COLLEGE
  MADRASA
  OPEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// -----------------------------------------------------------------------------
// Pre-Works Models
// -----------------------------------------------------------------------------

model EditionCategory {
  id          String   @id @default(uuid())
  editionId   String
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  
  programmes  Programme[]
  participants Participant[] // Optional: Linking participant to a default/main category if needed

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("edition_category")
}

model Programme {
  id          String        @id @default(uuid())
  editionId   String
  edition     Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    EditionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  type        ProgrammeType @default(INDIVIDUAL)
  stageType   StageType     @default(STAGE)
  maxEntries  Int           @default(1) // Max participants per group/school if applicable, or generic limit

  assignments ProgrammeAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programme")
}

model EditionGroup {
  id          String    @id @default(uuid())
  editionId   String
  edition     Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)

  name        String
  type        GroupType @default(SCHOOL)

  participants Participant[]
  assignments  ProgrammeAssignment[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("edition_group")
}

model ProgrammeAssignment {
  id            String    @id @default(uuid())
  editionId     String
  edition       Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)

  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  // Polymorphic-ish assignment: Usually assigning a participant.
  // For group events, we might still assign individual participants OR a group entity.
  // Requirement says: "participantId // OR groupId (for group events)"
  // Keeping it clean: A Participant is the core entity. Even for group events, you assign 'members'.
  // IF the user specifically wants to assign a "Group" entity directly, we'd need a groupId field here.
  // Based on "participantId // OR groupId", I will add optional groupId but prioritize participant logic if strict MVC.
  // Let's stick to explicit fields.
  
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  groupId       String?
  group         EditionGroup? @relation(fields: [groupId], references: [id]) 

  assignedAt    DateTime @default(now())

  // Validation should ensure either participantId OR groupId is set, not both (or as per logic).
  // Also uniqueness: A participant shouldn't be assigned to the same programme twice.

  @@unique([programmeId, participantId])
  // @@unique([programmeId, groupId]) // Conditional uniqueness difficult in pure Prisma, handle in service.
  
  @@map("programme_assignment")
}

model Participant {
  id        String  @id @default(uuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  // Relations
  groupId   String
  group     EditionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  categoryId String
  category   EditionCategory @relation(fields: [categoryId], references: [id]) // Restrict delete if participants exist? Or Cascade?

  name               String
  email              String? // Made optional as per some festival contexts (children) but unique constraint might need review
  phone              String?
  gender             Gender?
  registrationNumber String? // Optional chest number/ID

  assignments ProgrammeAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([editionId, email]) // Keep email unique per edition if provided? 
  // If email is optional, unique constraint on nulls varies by DB. Postgres supports multiple nulls.
  // If email is NOT empty string. A service level check is safer if logic is complex.
  
  @@map("participant")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorRole   String
  action      String   // e.g., "DELETE_FESTIVAL", "FREEZE_EDITION"
  targetType  String   // e.g., "FESTIVAL", "EDITION"
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}
