// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum Tier {
  BASIC
  STANDARD
  PRO
}

enum InstitutionType {
  COLLEGE
  MADRASA
  SCHOOL
  OTHER
}

enum FestivalStatus {
  DRAFT // created but locked
  ACTIVE // unlocked (paid)
  EXPIRED // past 40 days
}

// -----------------------------------------------------------------------------
// Core Models
// -----------------------------------------------------------------------------

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String 
  globalRole GlobalRole @default(USER)

  // Profile Fields
  fullName    String?
  displayName String?
  age         Int?
  isActive    Boolean @default(true)

  festival Festival? // ONE festival max
  payments Payment[]
  tokens   PasswordResetToken[]
  memberOf FestivalMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  expires   DateTime
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@map("password_reset_token")
}

enum PaymentPurpose {
  FESTIVAL_CREATION
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id          String  @id @default(uuid())
  amount      Int
  currency    String
  status      PaymentStatus @default(PENDING)
  providerId  String // Razorpay Order ID
  referenceId String? // Razorpay Payment ID
  receipt     String?

  tier        Tier?  // Stored for immutable record

  purpose     PaymentPurpose @default(FESTIVAL_CREATION)
  used        Boolean        @default(false)      // True if this payment has been "redeemed"

  validUntil DateTime? 

  userId String
  user   User   @relation(fields: [userId], references: [id])

  festivalId String?
  festival   Festival? @relation(fields: [festivalId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment")
}

model Festival {
  id      String @id @default(uuid())
  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id])

  name      String
  slug      String  @unique
  description String?
  
  // Organization Details
  category  String?
  orgName String?
  orgDescription String?
  orgWebsite String?
  orgLocation String?
  establishedYear Int?

  // Core Fields
  institutionType InstitutionType?
  institutionName String?
  location        String?
  startDate       DateTime?
  endDate         DateTime?
  expiresAt       DateTime?

  // Founder/Message
  founderName String?
  founderMessage String?

  branding  Json?
  rules     Json?
  structure Json?

  status   FestivalStatus @default(DRAFT)
  isLocked Boolean        @default(true)
  
  // Tier & Usage
  tier        Tier @default(STANDARD)
  tierLabel   String @default("Standard")
  
  // Usage Counters
  studentsCount     Int @default(0)
  programmesCount   Int @default(0) // Student competition programmes count
  eventsCount       Int @default(0) // Public events (Talks, Ceremonies) count
  stagesCount       Int @default(0)
  storageUsedMB     Int @default(0)

  // Deadlines
  studentCreationDeadline     DateTime?
  programmeAssignmentDeadline DateTime?

  // Settings
  chestNumberSettings Json? // { prefix: string, nextSequence: number }


  // Child Entities
  payments      Payment[]
  students      Student[]
  categories    Category[]
  groups        Group[]
  programmes    Programme[]
  events        Event[] // Public Events (Talks, Ceremonies)
  programmeAssignments ProgrammeAssignment[]
  stages        Stage[]
  results       Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       FestivalMember[]
  
  @@map("festival")
}

enum FestivalRole {
  ADMIN
  ANNOUNCER
  STAGE_MANAGER
}

model FestivalMember {
  id        String   @id @default(uuid())
  
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      FestivalRole @default(ANNOUNCER)
  
  isActive  Boolean @default(true)
  metadata  Json?   // Store initial password here if absolutely needed for "Show Password" feature

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([festivalId, userId])
  @@map("festival_member")
}

model Category {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  name        String
  type        CategoryType @default(SINGLE)
  description String?
  
  programmes  Programme[]
  students    Student[]

  assignments ProgrammeAssignment[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("category")
}

enum CategoryType {
  SINGLE
  GENERAL
}

model Programme {
  id          String        @id @default(uuid())
  festivalId  String
  festival    Festival      @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name        String
  type        ProgrammeType @default(INDIVIDUAL)
  stageType   StageType     @default(STAGE)
  maxParticipantsPerGroup Int @default(1) // For Individual: Max assignments per group
  maxTeamsPerGroup        Int @default(1) // For Group: Max teams per group
  maxStudentsPerTeam      Int @default(1) // For Group: Max students per team

  assignments ProgrammeAssignment[]
  results     Result[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("programme")
}

model Group {
  id          String    @id @default(uuid())
  festivalId  String
  festival    Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  name        String
  color       String    @default("#2563eb")
  seriesStart Int       @default(100)

  students    Student[]
  assignments  ProgrammeAssignment[]


  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("group")
}

model ProgrammeAssignment {
  id            String    @id @default(uuid())
  festivalId    String
  festival      Festival  @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  programmeId   String
  programme     Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  studentId     String?
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  groupId       String?
  group         Group? @relation(fields: [groupId], references: [id]) 

  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id]) 

  teamNumber    Int      @default(1)

  result        Result?

  assignedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  @@unique([programmeId, studentId])
  
  @@map("programme_assignment")
}

model Result {
  id            String              @id @default(uuid())
  festivalId    String
  festival      Festival            @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  
  programmeId   String
  programme     Programme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  
  assignmentId  String              @unique
  assignment    ProgrammeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  
  // Scoring & Ranking
  score         Float?              // Total marks/score
  grade         String?             // A+, A, B+, B, C, etc.
  position      Int?                // 1, 2, 3 (rank within programme)
  points        Int                 @default(0) // Points awarded based on position
  
  // Metadata
  remarks       String?             // Judge comments/feedback
  isPublished   Boolean             @default(false) // Control public visibility
  
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  
  @@map("result")
}

model Student {
  id        String   @id @default(uuid())
  
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name       String
  email      String?
  phone      String?
  gender     Gender   @default(MALE)
  
  // registrationNumber String? // Removed as per request
  chestNumber        String? // Generated Chest Number
  isTeamLeader       Boolean @default(false)
  
  age                Int?
  standard           String? // Class/Standard

  assignments ProgrammeAssignment[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@unique([festivalId, phone]) // Keep phone unique if used
  @@index([festivalId])
  @@index([groupId])
  @@unique([festivalId, chestNumber])
  @@map("student")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorRole   String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("audit_log")
}

enum ProgrammeType {
  INDIVIDUAL
  GROUP
}

enum StageType {
  STAGE
  NON_STAGE
}

enum GroupType {
  SCHOOL
  COLLEGE
  MADRASA
  OPEN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Event {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  name        String
  description String?
  date        DateTime?
  location    String? // Could link to Stage but keeping flexible for public events
  
  // Optional: Type
  type        EventType @default(GENERAL)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("event")
}

enum EventType {
  GENERAL
  CEREMONY
  TALK
  CONCERT
}

model Stage {
  id          String   @id @default(uuid())
  festivalId  String
  festival    Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)

  name        String
  description String?
  
  // Who created it (User Name or ID)
  createdBy   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("stage")
}
