{
  "buildCommand": "npm run build",
  "framework": "nextjs",

  "regions": ["bom1"],
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    }
  ]
}
